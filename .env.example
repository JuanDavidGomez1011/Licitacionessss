# Copiar a .env y ajustar los valores locales.
# NUNCA subir el .env real: contiene credenciales.

# PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=cambiar_esto
PG_DATABASE=licitaciones
DB_ECHO=false

# SECOP / Socrata
SOCRATA_BASE_URL=https://www.datos.gov.co/resource
DATASET_PROCESOS=jbjy-vk9h
DATASET_CONTRATOS=jbjy-vk9h
SOCRATA_APP_TOKEN=
HTTP_TIMEOUT=60
PAGE_SIZE=1000
REQUEST_DELAY=0.5

# Ollama / embeddings
OLLAMA_URL=http://localhost:11434
OLLAMA_REQUIRED=false
OLLAMA_LLM=llama3.1
OLLAMA_EMBED_MODEL=nomic-embed-text
EMBEDDING_DIMS=768
OLLAMA_NUM_CTX=8192
OLLAMA_TIMEOUT=120

# Scoring
SCORE_CANDIDATE_POOL=500
SCORE_BATCH_SIZE=50
SCORE_MIN_THRESHOLD=0.3

# Sincronización / scheduler
SYNC_LOOKBACK_DAYS=30
SYNC_CATCHUP_DAYS=7
SYNC_INTERVAL_MINUTES=60
SYNC_LOOKBACK_FREQUENT_DAYS=7
SYNC_STARTUP_IF_STALE_MINUTES=120
SYNC_ALERT_FAILED_STREAK=3
SYNC_CRON_HOUR=6
SYNC_CRON_MINUTE=0
ENABLE_SCHEDULER=false

# CORS
CORS_ORIGINS=http://localhost:5173
